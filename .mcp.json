{
  "mcpServers": {
    "exchange-mongo": {
      "type": "stdio",
      "command": "${SSP_MING_NODE:-node}",
      "args": [
        "../ssp-ming-mcp/node_modules/tsx/dist/cli.mjs",
        "../ssp-ming-mcp/src/mongo/server.ts"
      ],
      "env": {
        "SSP_MING_MCP_TARGET": "${SSP_MING_MCP_TARGET:-}",
        "MONGO_URI": "${MONGO_URI:-}",
        "BIDDERS_MONGO_URI": "${BIDDERS_MONGO_URI:-}"
      }
    },
    "victoriametrics": {
      "type": "stdio",
      "command": "${SSP_MING_NODE:-node}",
      "args": [
        "../ssp-ming-mcp/node_modules/tsx/dist/cli.mjs",
        "../ssp-ming-mcp/src/victoriametrics/server.ts"
      ],
      "env": {
        "SSP_MING_MCP_TARGET": "${SSP_MING_MCP_TARGET:-}",
        "VM_URL": "${VM_URL:-}",
        "VMAGENT_URL": "${VMAGENT_URL:-}"
      }
    },
    "ssp-signoz": {
      "type": "stdio",
      "command": "${SSP_MING_NODE:-node}",
      "args": [
        "../ssp-ming-mcp/node_modules/tsx/dist/cli.mjs",
        "../ssp-ming-mcp/src/signoz/server.ts"
      ],
      "env": {
        "SSP_MING_MCP_TARGET": "${SSP_MING_MCP_TARGET:-}",
        "SIGNOZ_URL": "${SSP_MING_SIGNOZ_URL:-}",
        "SIGNOZ_API_KEY": "${SSP_MING_SIGNOZ_API_KEY:-}",
        "SIGNOZ_EKS_API_KEY": "${SSP_MING_SIGNOZ_EKS_API_KEY:-}"
      }
    }
  }
}
